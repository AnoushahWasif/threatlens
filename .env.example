# Copy to apps/api/.env for local development. Never commit .env.
# Real values live in AWS Secrets Manager once deployed.
THREATLENS_ENVIRONMENT=dev
THREATLENS_CORS_ORIGINS=["http://localhost:3000"]
# Required (20+ chars) when THREATLENS_ENVIRONMENT=prod or the LLM provider is on
THREATLENS_LLM_API_KEY=
# Threat-model drafting: "off" (default, no calls, no cost) or "anthropic"
THREATLENS_LLM_PROVIDER=off
THREATLENS_LLM_MODEL=claude-opus-5-5
THREATLENS_LLM_DRAFTS_PER_HOUR=20
THREATLENS_LLM_DRAFTS_PER_USER_PER_HOUR=5
# DynamoDB write units (1 per KB written) per user per hour
THREATLENS_WRITE_UNITS_PER_USER_PER_HOUR=20000
# Sign-in: "local" (dev stand-in, refused in prod) or "cognito"
THREATLENS_AUTH_MODE=local
# Cognito only: the pool's region and id, and the web app client id
THREATLENS_COGNITO_REGION=
THREATLENS_COGNITO_USER_POOL_ID=
THREATLENS_AUTH_CLIENT_ID=threatlens-local
# Storage: "memory" (default, lost on restart, refused in prod) or "dynamodb"
THREATLENS_STORE=memory
THREATLENS_DYNAMODB_TABLE=threatlens
THREATLENS_AWS_REGION=eu-west-2
# DynamoDB Local only (e.g. http://localhost:8000); the API creates the table there.
THREATLENS_DYNAMODB_ENDPOINT_URL=

# Web (copy to apps/web/.env.local). Baked into the browser bundle: never put a secret here.
# Leave empty to run the web app on sample data.
NEXT_PUBLIC_API_URL=
# "local" (default) or "cognito". The client id is public: the app client has no secret.
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
